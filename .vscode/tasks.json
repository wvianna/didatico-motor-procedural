{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "deps: install",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--no-audit",
				"--no-fund"
			],
			"group": "build"
		},
		{
			"label": "test: unit",
			"type": "shell",
			"command": "npm",
			"args": [
				"test"
			],
			"group": "test"
		},
		{
			"label": "build: bundle",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"group": "build"
		},
		{
			"label": "build dist (verificacao)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"group": "build"
		},
		{
			"label": "serve: preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"preview",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"4173",
				"--strictPort"
			],
			"isBackground": true
		},
		{
			"label": "diag: explosion",
			"type": "shell",
			"command": "node",
			"args": [
				"scripts/check-explosion.mjs"
			],
			"group": "test"
		},
		{
			"label": "diag: explosion 2",
			"type": "shell",
			"command": "node",
			"args": [
				"scripts/check-explosion.mjs"
			],
			"group": "test"
		},
