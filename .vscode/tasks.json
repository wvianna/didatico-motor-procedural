			"label": "build dist (v2)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"group": "build"
		},
		{
			"label": "build dist (v3)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"group": "build"
		},
		{
			"label": "file: replace camera rig",
			"type": "shell",
			"command": "mv",
			"args": [
				"-f",
				"src/scene/CameraRig.next.js",
				"src/scene/CameraRig.js"
			],
			"group": "build"
		},
		{
			"label": "test: v2",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"test"
			],
			"group": "test"
		},
		{
